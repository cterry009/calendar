DATABASE_URL="postgresql://calendar:calendar@localhost:5432/calendar?schema=public"
PORT=3000

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_ROUNDS=12

GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# Planning (task 8.13), all optional. Without a key the heuristic planner answers; without
# LAYA_URL each task keeps its stored complexity. Free key: https://aistudio.google.com
GEMINI_API_KEY=""
# Comma list, tried in order (the newest free model is often busy).
GEMINI_MODEL="gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
# Laya's server (services/laya/start.ps1).
LAYA_URL="http://127.0.0.1:8100"
# Defaults to <CALENDAR_VAULT or ~/Documents/Notas de Fisica>/Prompt_app_calendario.md
# PLANNING_RULES_PATH=""
# Attention rubric + reference labels (default: ../docs/planning from server/).
# ATTENTION_DOCS_PATH=""
