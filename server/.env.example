DATABASE_URL="postgresql://calendar:calendar@localhost:5432/calendar?schema=public"
PORT=3000

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
BCRYPT_ROUNDS=12

GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# Planning (task 8.13), all optional. Without a key the heuristic planner answers; without
# LAYA_URL each task keeps its stored complexity. Free key: https://aistudio.google.com
GEMINI_API_KEY=""
# Comma list, tried in order (the newest free model is often busy).
GEMINI_MODEL="gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
# Laya's server (services/laya/start.ps1).
LAYA_URL="http://127.0.0.1:8100"
# Defaults to <CALENDAR_VAULT or ~/Documents/Notas de Fisica>/Prompt_app_calendario.md
# PLANNING_RULES_PATH=""
# Attention rubric + reference labels (default: ../docs/planning from server/).
# ATTENTION_DOCS_PATH=""

# Study tutor (openspec study-tutor-game phase 3), optional. It runs the Claude Code CLI with the
# session logged in on this machine (no API key); without it, POST /tutor/turn answers 503.
# TUTOR_MODEL="opus"            # the user's choice; "sonnet" is ~2x faster and ~1/3 of the quota
# TUTOR_CLAUDE_BIN="claude"     # or a full path, e.g. C:\Users\<you>\.local\bin\claude.exe
# TUTOR_TIMEOUT_MS="180000"
# The vault is CALENDAR_VAULT (default ~/Documents/Notas de Fisica), as for planning.

# Study status in the vault (dynamic-study-blocks D18): the server rewrites Estado_estudio.md and
# estado_estudio.json ~30 s after study changes, only for this account (the dev database has many
# test accounts). Unset = never written; scripts/export-study-status.mjs still works by hand.
# STUDY_STATUS_EMAIL="dev@local.test"
# STUDY_STATUS_DEBOUNCE_MS="30000"

# Daily email report (daily-email-report): at DAILY_REPORT_TIME the account DAILY_REPORT_EMAIL gets
# the day's report and the next day's plan (a suggested plan when nothing is planned, approved in the
# apps). Sent through Gmail with an app password (myaccount.google.com/apppasswords, needs 2-step
# verification). Missing any of the three = never sent. A report missed while the server was off goes
# out at the next start.
# DAILY_REPORT_EMAIL="you@gmail.com"
# DAILY_REPORT_SMTP_USER="you@gmail.com"
# DAILY_REPORT_SMTP_PASSWORD="abcd efgh ijkl mnop"
# DAILY_REPORT_TIME="21:00"
# DAILY_REPORT_TIMEZONE="America/Bogota"   # default: the server machine's time zone
# The Sunday report (weekend-mode) uses the same account and credentials, at this time:
# WEEKLY_REPORT_TIME="18:00"
