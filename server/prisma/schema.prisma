generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum DevicePlatform {
  WEB
  ANDROID
  IOS
  WINDOWS
  MACOS
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ScheduleKind {
  WORK
  REST
}

enum PomodoroState {
  IDLE
  FOCUS
  SHORT_BREAK
  LONG_BREAK
}

enum BlockListKind {
  MOBILE_APP
  WEBSITE
  DESKTOP_APP
}

// Task 11.8: which trigger a BlockListEntry belongs to. FOCUS is the existing pomodoro/work-hours
// list (default, so every pre-existing row keeps behaving exactly as before); NIGHT is the new
// 22:30-08:00 automatic window (task 11.10), a deliberately separate list from FOCUS per the
// user's own request, not a scoped view of the same one.
enum BlockListScope {
  FOCUS
  NIGHT
}

enum FocusTriggerKind {
  LOCATION
  WIFI
}

enum FitnessIntensity {
  LOW
  MEDIUM
  HIGH
}

enum FitnessSource {
  MANUAL
  HEALTH_CONNECT
  HEALTHKIT
  CSV_IMPORT
  DEVICE_SENSOR
}

enum AnalyticsPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum HabitType {
  NORMAL
  NEGATIVE
}

enum HabitRecordStatus {
  DONE
  SKIPPED
}

// ─── Auth & devices ──────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  googleId     String?  @unique
  appleId      String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices            Device[]
  tasks              Task[]
  schedules          Schedule[]
  pomodoroSessions   PomodoroSession[]
  blockListEntries   BlockListEntry[]
  focusTriggers      FocusTrigger[]
  fitnessEntries     FitnessEntry[]
  dailyStepCounts    DailyStepCount[]
  dailyFloorsClimbed DailyFloorsClimbed[]
  analyticsSnapshots AnalyticsSnapshot[]
  detoxPlan          DetoxPlan?
  serotoninSession   SerotoninSession?
  habits             Habit[]
  habitRecords       HabitRecord[]
  journalEntries     JournalEntry[]

  @@map("users")
}

model Device {
  id           String         @id @default(cuid())
  userId       String
  label        String
  platform     DevicePlatform
  refreshToken String?        @unique
  lastSeenAt   DateTime       @default(now())
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

// ─── Calendar & tasks ────────────────────────────────────────────────────────

model Task {
  id                 String         @id @default(cuid())
  userId             String
  title              String
  description        String?
  scheduledAt        DateTime?
  estimatedMinutes   Int
  // How many pomodoros the user actually said ("3 pomodoros") -- kept alongside estimatedMinutes
  // so the count shown back to them never drifts from what they typed, regardless of which
  // pomodoro length was used to convert it. Null for tasks created before this field existed.
  estimatedPomodoros Int?
  actualMinutes      Int?
  difficulty         TaskDifficulty @default(MEDIUM)
  complexity         Int            @default(5) // 1–10
  priority           TaskPriority   @default(MEDIUM)
  category           String?
  status             TaskStatus     @default(PENDING)
  completedAt        DateTime?
  clientId           String? // offline sync id from client
  deletedAt          DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pomodoroSessions PomodoroSession[]

  @@unique([userId, clientId])
  @@index([userId, scheduledAt])
  @@index([userId, status])
  @@map("tasks")
}

model Schedule {
  id          String       @id @default(cuid())
  userId      String
  kind        ScheduleKind
  daysOfWeek  Int[] // 0 = Sunday … 6 = Saturday; days this recurring schedule applies to
  startMinute Int // minutes from midnight (0–1439)
  endMinute   Int
  label       String?
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // User-tunable auto-pomodoro plan for WORK schedules; null = use the app's adaptive default.
  pomodoroMin       Int?
  shortBreakMin     Int?
  longBreakMin      Int?
  pomodorosPerChunk Int?
  chunks            Int? // number of pomodoro blocks (separated by long breaks); must fit within startMinute..endMinute

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("schedules")
}

// ─── Pomodoro ────────────────────────────────────────────────────────────────

model PomodoroSession {
  id                    String        @id @default(cuid())
  userId                String
  taskId                String?
  state                 PomodoroState @default(IDLE)
  focusDurationMin      Int           @default(25)
  shortBreakMin         Int           @default(5)
  longBreakMin          Int           @default(15)
  cyclesBeforeLongBreak Int           @default(4)
  completedCycles       Int           @default(0)
  active                Boolean       @default(false)
  interrupted           Boolean       @default(false)
  startedAt             DateTime?
  endedAt               DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@map("pomodoro_sessions")
}

// ─── Focus blocking ──────────────────────────────────────────────────────────

model BlockListEntry {
  id           String          @id @default(cuid())
  userId       String
  kind         BlockListKind
  identifier   String // package name, domain, or exe name
  label        String
  platform     DevicePlatform?
  highDopamine Boolean         @default(false) // serotonin / detox mode
  enabled      Boolean         @default(true)
  hardMode     Boolean         @default(false) // non-cancelable once a native blocker (Android/Windows) enforces it
  // Task 11.8: FOCUS (default, matches every pre-existing row's actual behavior) or NIGHT --
  // which trigger this entry belongs to. Part of the uniqueness key (not just userId+kind+
  // identifier) so the same app/site can be listed in both the daytime FOCUS list and the NIGHT
  // list independently, since they're deliberately separate lists, not one filtered view.
  scope        BlockListScope  @default(FOCUS)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, identifier, scope])
  @@index([userId])
  @@map("block_list_entries")
}

// A trigger widens how focus-blocking activates beyond a running session
// (pomodoro/task/work-hours): LOCATION is enforced for real in the web app via
// the browser Geolocation API; WIFI has no browser API to read the connected
// SSID, so it's stored now and only enforceable once the native Android/Windows
// blockers exist (see design.md decision on this).
model FocusTrigger {
  id           String           @id @default(cuid())
  userId       String
  kind         FocusTriggerKind
  label        String
  enabled      Boolean          @default(true)
  latitude     Float?
  longitude    Float?
  radiusMeters Int?
  wifiSsid     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("focus_triggers")
}

// ─── Fitness ─────────────────────────────────────────────────────────────────

model FitnessEntry {
  id              String           @id @default(cuid())
  userId          String
  activityType    String
  durationMinutes Int
  intensity       FitnessIntensity @default(MEDIUM)
  notes           String?
  loggedAt        DateTime
  source          FitnessSource    @default(MANUAL)
  externalId      String? // HealthKit / Health Connect id
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitRecords HabitRecord[]

  @@index([userId, loggedAt])
  @@map("fitness_entries")
}

// One row per user per calendar day (task 10.6) -- deliberately not an append-only log like
// FitnessEntry, since a device's step sensor reports a running daily total, not discrete
// sessions. `date` is day-truncated UTC midnight; `steps` is a monotonically-increasing daily
// total merged across devices via max(), not overwritten (see SyncService.applyStepCountChange
// -- a stale device reporting a smaller same-day count than what's already stored must never
// erase a higher count another device already reported today).
model DailyStepCount {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  steps     Int
  source    FitnessSource @default(DEVICE_SENSOR)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_step_counts")
}

// One row per user per calendar day (task 10.8) -- same shape and merge reasoning as
// DailyStepCount: a phone's barometer feeds a running daily total of floors climbed, merged
// across devices via max(floors), not overwritten (see SyncService.applyFloorsClimbedChange).
model DailyFloorsClimbed {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  floors    Int
  source    FitnessSource @default(DEVICE_SENSOR)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_floors_climbed")
}

// ─── Serotonin detox plan ────────────────────────────────────────────────────

model DetoxPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  planData  Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("detox_plans")
}

// ─── Serotonin wellness session (pillars/rituals/mood, rotates daily) ────────

model SerotoninSession {
  id          String   @id @default(cuid())
  userId      String   @unique
  sessionData Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("serotonin_sessions")
}

// ─── Analytics ───────────────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id                   String          @id @default(cuid())
  userId               String
  period               AnalyticsPeriod
  periodStart          DateTime
  periodEnd            DateTime
  tasksCompleted       Int             @default(0)
  pomodorosCompleted   Int             @default(0)
  pomodorosInterrupted Int             @default(0)
  focusMinutes         Int             @default(0)
  estimatedMinutes     Int             @default(0)
  actualMinutes        Int             @default(0)
  estimationErrorPct   Float?
  serotoninScore       Int?
  fitnessMinutes       Int             @default(0)
  suggestions          Json? // rule-based suggestions generated for the period
  metadata             Json? // extra breakdown (by difficulty, peak hours, etc.)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, periodStart])
  @@index([userId, periodStart])
  @@map("analytics_snapshots")
}

// ─── Habits ──────────────────────────────────────────────────────────────────
// Design ported from mhabit (https://github.com/FriesI23/mhabit, Apache 2.0):
// the domain logic (score curve) is reimplemented natively in
// packages/shared/src/habits/score.ts, not copied — this schema only mirrors
// the concepts (habit type, daily goal, target days) needed to feed it. Score
// is intentionally NOT persisted here: it's recomputed by replaying the full
// HabitRecord history on read, same as mhabit does client-side.

model Habit {
  id                        String    @id @default(cuid())
  userId                    String
  title                     String
  description               String?
  type                      HabitType @default(NORMAL)
  dailyGoalValue            Float     @default(1)
  dailyGoalUnit             String    @default("times")
  dailyGoalExtraValue       Float? // optional bonus/tolerance ceiling, see mhabit's scoreExtraMax
  targetDays                Int       @default(66) // days to consolidate the habit; parametrizes the score curve
  color                     String?
  category                  String?
  archived                  Boolean   @default(false)
  // Case-insensitive match against FitnessEntry.activityType; when set, a matching fitness log
  // auto-creates/updates today's HabitRecord instead of requiring a manual check-in.
  linkedFitnessActivityType String?
  // Task 11.5: optional reminder window driving the mobile confirmation notification (task 11.6).
  // Nullable/no migration-of-existing-data needed -- a habit with no reminder set simply never
  // schedules one, same as every existing web-created Habit row before this field existed.
  // reminderEndMinute is also the notification's fire time for a deadline-style habit (e.g.
  // "wake up before 7am" has no start, just an end); reminderStartMinute matters for a
  // window-style habit (e.g. "arreglarse 7-8am") where the UI wants to show both bounds.
  reminderStartMinute Int?
  reminderEndMinute   Int?
  reminderDaysOfWeek  Int[]     @default([0, 1, 2, 3, 4, 5, 6]) // 0=Sunday..6=Saturday, matches Schedule.daysOfWeek's convention
  clientId                  String? // offline sync id from client
  deletedAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  records        HabitRecord[]
  journalEntries JournalEntry[]

  @@unique([userId, clientId])
  @@index([userId, archived])
  @@map("habits")
}

model HabitRecord {
  id             String            @id @default(cuid())
  habitId        String
  userId         String
  date           DateTime // calendar day this check-in belongs to
  value          Float             @default(0)
  status         HabitRecordStatus @default(DONE)
  autoCompleted  Boolean           @default(false) // true when derived from a FitnessEntry instead of a manual check-in
  fitnessEntryId String?
  clientId       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  habit          Habit          @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitnessEntry   FitnessEntry?  @relation(fields: [fitnessEntryId], references: [id], onDelete: SetNull)
  journalEntries JournalEntry[]

  @@unique([habitId, date])
  @@unique([userId, clientId])
  @@index([userId, date])
  @@map("habit_records")
}

model JournalEntry {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  recordId  String?
  content   String
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit  Habit        @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  record HabitRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([habitId, createdAt])
  @@map("journal_entries")
}
