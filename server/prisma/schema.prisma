generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum DevicePlatform {
  WEB
  ANDROID
  IOS
  WINDOWS
  MACOS
  // projects-and-claude-bridge (2026-11-08): the local Claude MCP bridge, its own revocable device.
  AGENT
}

enum TaskDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ScheduleKind {
  WORK
  REST
}

enum PomodoroState {
  IDLE
  FOCUS
  SHORT_BREAK
  LONG_BREAK
}

enum BlockListKind {
  MOBILE_APP
  WEBSITE
  DESKTOP_APP
}

// Task 11.8: which trigger a BlockListEntry belongs to. FOCUS is the existing pomodoro/work-hours
// list (default, so every pre-existing row keeps behaving exactly as before); NIGHT is the new
// 22:30-08:00 automatic window (task 11.10), a deliberately separate list from FOCUS per the
// user's own request, not a scoped view of the same one.
enum BlockListScope {
  FOCUS
  NIGHT
}

enum FocusTriggerKind {
  LOCATION
  WIFI
}

// Task 8.2: what kind of blocking moment a BlockEvent row records. BLOCKED_OPEN_ATTEMPT is the
// user actually opening a listed app while it's enforced (FOCUS or NIGHT); NIGHT_UNLOCK is the
// morning-portion unlock transition (jog or 1000+ steps, see NightBlockRules.kt) firing, which
// has no associated app -- identifier is null for that trigger.
enum BlockEventTrigger {
  BLOCKED_OPEN_ATTEMPT
  NIGHT_UNLOCK
  // 2026-10-15: the first phone use after the night window, and the answer to the
  // "¿Ya hiciste ejercicio?" card shown then (FocusBlockAccessibilityService.maybeAskMorningExercise).
  MORNING_FIRST_USE
  MORNING_EXERCISE_YES
  MORNING_EXERCISE_NO
}

// Attention profile of a task or a pomodoro block (docs/planning/normas-de-atencion.md):
// MECHANICAL 15/5 in a 60-min block, LIGHT 25/5 and DEEP 40/5 in 90-min blocks. Set from the
// (reentry, load) rating by a fixed table, never by a model.
enum AttentionProfile {
  MECHANICAL
  LIGHT
  DEEP
}

// Who rated a task's attention: the reference labels (docs/planning/anclas.json), a model, or the user.
enum AttentionSource {
  REFERENCE
  MODEL
  USER
}

// Study game (openspec study-tutor-game, phase 2, 2026-10-21). Lowercase on purpose: the rows go
// straight into the shared `replay` (ExerciseAttemptInput) without mapping.
enum ExerciseSource {
  nota
  generado
}

enum ExerciseGrader {
  claude
  usuario
}

// What a FocusEvent records. All of it is telemetry for calibrating profiles and training models.
enum FocusEventKind {
  BLOCK_PROMPT_ACCEPTED // "Iniciar" on the block-start notification
  BLOCK_PROMPT_SNOOZED // "En 5 min"
  BLOCK_PROMPT_DECLINED // "Hoy no"
  BLOCK_PROMPT_OPENED // tapped the notification without picking an action
  FOCUS_STARTED
  FOCUS_COMPLETED
  BREAK_COMPLETED
  SESSION_CANCELLED // the user stopped it before the block ended
  BLOCK_ENDED // the session ran until the block's fixed end
  CHECK_IN // self-reported minutes of real concentration
  BLOCK_EXITED // "Salir" during a WORK block: the session pauses
  BLOCK_RESUMED // "Volver al bloque"
  BLOCK_SKIPPED // "No puedo hacer este bloque" for that day
  BLOCK_EXIT_REASON // why the user left a block, and whether it was rescheduled (meta.reason, meta.rescheduled)
  SEGMENT_CUT // "Cortar tramo": a sequence's focus segment ended early, straight into the next pause
}

enum FitnessIntensity {
  LOW
  MEDIUM
  HIGH
}

enum FitnessSource {
  MANUAL
  HEALTH_CONNECT
  HEALTHKIT
  CSV_IMPORT
  DEVICE_SENSOR
}

enum AnalyticsPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum HabitType {
  NORMAL
  NEGATIVE
}

// weekend-mode (2026-11-04): a WEEKEND_ACTIVITY is a reminder for something to do on Saturday or
// Sunday (packages/shared/src/habits/weekendActivities.ts) -- a Habit for its reminder and check-in,
// but outside the habit list and score, at most 3 a day.
enum HabitKind {
  HABIT
  WEEKEND_ACTIVITY
}

enum HabitRecordStatus {
  DONE
  SKIPPED
}

// ─── Auth & devices ──────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  googleId     String?  @unique
  appleId      String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  devices             Device[]
  tasks               Task[]
  schedules           Schedule[]
  pomodoroSessions    PomodoroSession[]
  blockListEntries    BlockListEntry[]
  focusTriggers       FocusTrigger[]
  fitnessEntries      FitnessEntry[]
  dailyStepCounts     DailyStepCount[]
  dailyFloorsClimbed  DailyFloorsClimbed[]
  dailyScreenTime     DailyScreenTime[]
  dailyGameTime       DailyGameTime[]
  dailyDesktopAppTime DailyDesktopAppTime[]
  analyticsSnapshots  AnalyticsSnapshot[]
  detoxPlan           DetoxPlan?
  serotoninSession    SerotoninSession?
  habits              Habit[]
  habitRecords        HabitRecord[]
  scheduleCompletions ScheduleCompletion[]
  journalEntries      JournalEntry[]
  blockEvents         BlockEvent[]
  focusEvents         FocusEvent[]
  exerciseAttempts    ExerciseAttempt[]
  studyPlan           StudyPlan?
  scheduleExceptions  ScheduleException[]
  dailyReports        DailyReport[]
  planSuggestions     PlanSuggestion[]
  weeklyReports       WeeklyReport[]
  blockCommitment     BlockCommitment?
  projects            Project[]
  projectLogEntries   ProjectLogEntry[]

  @@map("users")
}

model Device {
  id           String         @id @default(cuid())
  userId       String
  label        String
  platform     DevicePlatform
  refreshToken String?        @unique
  lastSeenAt   DateTime       @default(now())
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

// ─── Calendar & tasks ────────────────────────────────────────────────────────

model Task {
  id                 String            @id @default(cuid())
  userId             String
  title              String
  description        String?
  scheduledAt        DateTime?
  estimatedMinutes   Int
  // How many pomodoros the user actually said ("3 pomodoros") -- kept alongside estimatedMinutes
  // so the count shown back to them never drifts from what they typed, regardless of which
  // pomodoro length was used to convert it. Null for tasks created before this field existed.
  estimatedPomodoros Int?
  actualMinutes      Int?
  difficulty         TaskDifficulty    @default(MEDIUM)
  complexity         Int               @default(5) // 1–10
  // Attention rating (docs/planning/normas-de-atencion.md): reentry cost and mental load, 0-3 each,
  // and the profile the fixed table gives them. Null until rated.
  attentionReentry   Int?
  attentionLoad      Int?
  attentionProfile   AttentionProfile?
  attentionSource    AttentionSource?
  attentionReason    String?
  priority           TaskPriority      @default(MEDIUM)
  category           String?
  status             TaskStatus        @default(PENDING)
  completedAt        DateTime?
  clientId           String? // offline sync id from client
  deletedAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pomodoroSessions PomodoroSession[]

  // projects-and-claude-bridge: at most one project; deleting the project keeps the task.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([userId, scheduledAt])
  @@index([userId, status])
  @@map("tasks")
}

model Schedule {
  id          String       @id @default(cuid())
  userId      String
  kind        ScheduleKind
  daysOfWeek  Int[] // 0 = Sunday … 6 = Saturday; days this recurring schedule applies to
  startMinute Int // minutes from midnight (0–1439)
  endMinute   Int
  label       String?
  enabled     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // User-tunable auto-pomodoro plan for WORK schedules; null = use the app's adaptive default.
  pomodoroMin       Int?
  shortBreakMin     Int?
  longBreakMin      Int?
  pomodorosPerChunk Int?
  chunks            Int? // number of pomodoro blocks (separated by long breaks); must fit within startMinute..endMinute

  // Horario 2026-10-19: the plan category (estudio_b1, carrera, ...) and the block's pomodoro
  // sequence, [{tipo: foco|pausa|cierre, minutos, etiqueta}], which wins over pomodoroMin & co.
  category       String?
  sequence       Json?
  // The morning window (dynamic-study-blocks, 2026-10-22): this many blocks started on demand inside
  // it, each sized by a check-in; null for a fixed block.
  flexibleBlocks Int?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions ScheduleCompletion[]
  exceptions  ScheduleException[]

  @@index([userId, kind])
  @@map("schedules")
}

// A recurring schedule block marked done on a given day ("hice este bloque de trabajo hoy").
// Same shape as HabitRecord: one row per block per day, deleted to undo. `date` is the local
// calendar day, sent by clients as YYYY-MM-DD and stored as that day's UTC midnight -- the same
// convention HabitRecord.date uses, so both compare by the same date key.
enum ScheduleCompletionStatus {
  DONE
  SKIPPED
}

model ScheduleCompletion {
  id         String                   @id @default(cuid())
  userId     String
  scheduleId String
  date       DateTime
  // DONE: marked done. SKIPPED: "no puedo hacer este bloque" that day (2026-10-06): no prompt,
  // no overlay, no blocking, not counted as missed.
  status     ScheduleCompletionStatus @default(DONE)
  reason     String?
  clientId   String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date])
  @@unique([userId, clientId])
  @@index([userId, date])
  @@map("schedule_completions")
}

// One-off change to a recurring block on one day (horario 2026-10-19): moved, or switched to
// another category ("mover a carrera"). Null fields keep the block's own value. Same keying as
// ScheduleCompletion: one row per block per day, `date` stored as that day's UTC midnight.
model ScheduleException {
  id          String   @id @default(cuid())
  userId      String
  scheduleId  String
  date        DateTime
  category    String?
  label       String?
  startMinute Int?
  endMinute   Int?
  clientId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, date])
  @@unique([userId, clientId])
  @@index([userId, date])
  @@map("schedule_exceptions")
}

// The phased study plan (horario 2026-10-19): start Monday, phases, suggested pomodoros,
// milestones and adjustment rules, as one JSON document per user -- the same shape as DetoxPlan.
model StudyPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  planData  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("study_plans")
}

// ─── Pomodoro ────────────────────────────────────────────────────────────────

model PomodoroSession {
  id                    String            @id @default(cuid())
  userId                String
  taskId                String?
  state                 PomodoroState     @default(IDLE)
  focusDurationMin      Int               @default(25)
  shortBreakMin         Int               @default(5)
  longBreakMin          Int               @default(15)
  cyclesBeforeLongBreak Int               @default(4)
  completedCycles       Int               @default(0)
  active                Boolean           @default(false)
  interrupted           Boolean           @default(false)
  startedAt             DateTime?
  endedAt               DateTime?
  // Block mode: the session ends at the WORK block's fixed end, trimming its last phase.
  blockEndAt            DateTime?
  attentionProfile      AttentionProfile?
  // The WORK block this session belongs to (block mode).
  scheduleId            String?
  // "Salir" (2026-10-06): a paused session stops counting; resuming shifts startedAt forward.
  pausedAt              DateTime?
  // Times the user left this block with "Salir".
  exitCount             Int               @default(0)
  // Focus pomodoros of this session already rated (or dismissed) on any device: the other device
  // closes its card (2026-10-07). Only ever goes up (sync keeps the max).
  reviewedCycles        Int               @default(0)
  // Sequence mode (2026-10-15): the block's segments, anchored to blockStartAt; the running one;
  // and how many times "cortar tramo" was used (only ever goes up, like reviewedCycles).
  blockStartAt          DateTime?
  sequence              Json?
  segmentIndex          Int?
  cutCount              Int               @default(0)
  // Flexible morning block (2026-10-22): sequence relative to the real start, no blockEndAt;
  // windowEndAt stops new focuses; focusMinutes is real focus done and only goes up (sync keeps the max).
  flexible              Boolean           @default(false)
  plannedBlockMin       Int?
  windowEndAt           DateTime?
  focusMinutes          Int               @default(0)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, active])
  @@map("pomodoro_sessions")
}

// ─── Focus blocking ──────────────────────────────────────────────────────────

model BlockListEntry {
  id                       String          @id @default(cuid())
  userId                   String
  kind                     BlockListKind
  identifier               String // package name, domain, or exe name
  label                    String
  platform                 DevicePlatform?
  highDopamine             Boolean         @default(false) // serotonin / detox mode
  enabled                  Boolean         @default(true)
  hardMode                 Boolean         @default(false) // non-cancelable once a native blocker (Android/Windows) enforces it
  // Task 11.8: FOCUS (default, matches every pre-existing row's actual behavior) or NIGHT --
  // which trigger this entry belongs to. Part of the uniqueness key (not just userId+kind+
  // identifier) so the same app/site can be listed in both the daytime FOCUS list and the NIGHT
  // list independently, since they're deliberately separate lists, not one filtered view.
  scope                    BlockListScope  @default(FOCUS)
  // weekend-mode: a NIGHT entry's own start (minutes from midnight, 0 = from midnight), weeknights
  // and Friday/Saturday nights; null = the night window's (packages/shared/src/blocking/nightSchedule.ts).
  nightStartMinutes        Int?
  weekendNightStartMinutes Int?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, identifier, scope])
  @@index([userId])
  @@map("block_list_entries")
}

// Task 8.2: a pure append-only telemetry log -- "how many times did blocking actually trigger,"
// a metric that didn't exist anywhere before this (see tasks.md 8.2). No updatedAt/no update path
// at all: a past event is never edited, only ever created once. `id` is client-generated
// (native Kotlin, a UUID) and used directly as the idempotency key on sync -- the native side can
// only hand a batch of pending events to the JS offline queue when the app is next foregrounded,
// and that queue can retry a flush, so `id` has to be stable across retries rather than
// server-assigned. No deviceId, matching FitnessEntry/DailyStepCount/DailyFloorsClimbed's existing
// convention of not tracking per-record device provenance. `identifier` is nullable: a
// NIGHT_UNLOCK event isn't tied to any one app.
// Everything that happens around a focus block, logged on the device and synced like BlockEvent:
// immutable, idempotent on the client-generated id. Raw material for calibrating attention profiles
// and training the planning models. "Ignored" prompts aren't logged: they're the blocks with no row.
model FocusEvent {
  id                String            @id
  userId            String
  kind              FocusEventKind
  occurredAt        DateTime
  scheduleId        String?
  taskId            String?
  pomodoroSessionId String?
  attentionProfile  AttentionProfile?
  /// When the block was due to start; occurredAt minus this is how late the user started.
  blockStartAt      DateTime?
  /// Seconds for durations (focus elapsed before a cancel, ...), minutes for CHECK_IN.
  value             Int?
  meta              Json?
  createdAt         DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, kind])
  @@map("focus_events")
}

/// One graded try at a study exercise. Immutable like FocusEvent: the client id is the idempotency
/// key, and a regrade is a new row that `supersedes` the old one. The game state (θ, XP, levels) is
/// never stored: clients replay these rows (packages/shared study-game).
model ExerciseAttempt {
  id                 String         @id
  userId             String
  /// `AN1#3#2`, `AN1#cierre-rojo#D2`, or the tutor's id for a generated exercise.
  exerciseId         String
  exerciseSource     ExerciseSource
  noteCode           String
  section            String
  /// Difficulty on the logit scale when it was attempted.
  b                  Float
  /// 0, 0.5 or 1.
  r                  Float
  hints              Int            @default(0)
  minutes            Int?
  gradedBy           ExerciseGrader
  /// The attempt this one corrects; not a foreign key, since it can arrive before its original.
  supersedes         String?
  generatedStatement String?        @db.Text
  feedback           String?        @db.Text
  studyTaskId        String?
  pomodoroSessionId  String?
  occurredAt         DateTime
  createdAt          DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([userId, noteCode])
  @@map("exercise_attempts")
}

model BlockEvent {
  id         String            @id
  userId     String
  identifier String?
  scope      BlockListScope
  trigger    BlockEventTrigger
  occurredAt DateTime
  createdAt  DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@map("block_events")
}

// A trigger widens how focus-blocking activates beyond a running session
// (pomodoro/task/work-hours): LOCATION is enforced for real in the web app via
// the browser Geolocation API; WIFI has no browser API to read the connected
// SSID, so it's stored now and only enforceable once the native Android/Windows
// blockers exist (see design.md decision on this).
model FocusTrigger {
  id           String           @id @default(cuid())
  userId       String
  kind         FocusTriggerKind
  label        String
  enabled      Boolean          @default(true)
  latitude     Float?
  longitude    Float?
  radiusMeters Int?
  wifiSsid     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("focus_triggers")
}

// ─── Fitness ─────────────────────────────────────────────────────────────────

model FitnessEntry {
  id              String           @id @default(cuid())
  userId          String
  activityType    String
  durationMinutes Int
  intensity       FitnessIntensity @default(MEDIUM)
  notes           String?
  loggedAt        DateTime
  source          FitnessSource    @default(MANUAL)
  externalId      String? // HealthKit / Health Connect id
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitRecords HabitRecord[]

  @@index([userId, loggedAt])
  @@map("fitness_entries")
}

// One row per user per calendar day (task 10.6) -- deliberately not an append-only log like
// FitnessEntry, since a device's step sensor reports a running daily total, not discrete
// sessions. `date` is day-truncated UTC midnight; `steps` is a monotonically-increasing daily
// total merged across devices via max(), not overwritten (see SyncService.applyStepCountChange
// -- a stale device reporting a smaller same-day count than what's already stored must never
// erase a higher count another device already reported today).
model DailyStepCount {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  steps     Int
  source    FitnessSource @default(DEVICE_SENSOR)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_step_counts")
}

// One row per user per calendar day (task 10.8) -- same shape and merge reasoning as
// DailyStepCount: a phone's barometer feeds a running daily total of floors climbed, merged
// across devices via max(floors), not overwritten (see SyncService.applyFloorsClimbedChange).
model DailyFloorsClimbed {
  id        String        @id @default(cuid())
  userId    String
  date      DateTime
  floors    Int
  source    FitnessSource @default(DEVICE_SENSOR)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_floors_climbed")
}

// Task 8.3: reverses task 11.18's original "deliberately local-only, not synced" decision for
// screen time, now that the explicit ask is for the web dashboard to show it too. Syncs a *daily
// aggregate* (totalMinutes + the top few apps' minutes), not a raw per-app-open event log --
// keeps 11.18's original privacy-shaped reasoning (a full cross-app usage timeline never leaves
// the device) while still giving web something real to show. `topApps` is a small JSON array
// (`{ packageName, minutes }[]`, capped client-side) rather than its own table -- it's a derived
// snapshot recomputed fresh from Android's UsageStatsManager on every push, not data with its own
// identity/lifecycle worth normalizing. No `source`/multi-device merge logic like
// DailyStepCount/DailyFloorsClimbed: unlike a pedometer, only one Android phone per account
// realistically has usage-stats access at all, so the ordinary `updatedAt`-wins conflict rule
// every other synced entity uses is sufficient here.
model DailyScreenTime {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  totalMinutes Int
  topApps      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_screen_time")
}

// Windows desktop counterpart to DailyScreenTime -- same shape, same reasoning: only one Windows
// PC per account realistically runs Steam/Riot Client/Battle.net at a time, so a plain
// `updatedAt`-wins daily rollup is enough (no DailyStepCount-style multi-device max() merge).
// `topGames` entries are `{ key, label, minutes, source }` where `key` is the Steam appid (as a
// string) or the matched exe name for Riot/Battle.net games, and `source` is
// "STEAM" | "RIOT" | "BATTLENET". See apps/desktop/src-tauri/src/game_tracking.rs for how the
// per-game detection works (Steam via the HKCU...\Apps\<appid>\Running registry flag Steam itself
// uses; Riot/Battle.net via a curated known-game-process table).
model DailyGameTime {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  totalMinutes Int
  topGames     Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_game_time")
}

// Per-application foreground time on the Windows desktop -- the generic counterpart of
// DailyGameTime and the desktop counterpart of DailyScreenTime.
//
// **Why a separate table instead of reusing DailyScreenTime**: that model is keyed
// `@@unique([userId, date])` and is already written by Android. A desktop client writing per-app
// minutes into it would overwrite the phone's row for the same day (and vice versa), since neither
// side knows about the other's platform. Adding a `platform` discriminator to its key would mean
// migrating a path that is already verified on a real device, so the desktop gets its own table --
// the same choice already made for DailyGameTime.
//
// **Do not sum this with DailyGameTime.** They measure different things and overlap on purpose: a
// Steam game in the foreground is counted here (as active foreground use) and there (as game
// running). Present them as separate figures, never added into one "total time on the PC".
//
// `topApps` entries are `{ key, label, minutes }` where `key` is the lowercased exe name -- the
// same identifier shape a `DESKTOP_APP` BlockListEntry matches on, so a block suggestion can be
// built straight from a row here. Only the process name is collected, never window titles.
// See apps/desktop/src-tauri/src/app_tracking.rs for the foreground/idle detection.
model DailyDesktopAppTime {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  totalMinutes Int
  topApps      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_desktop_app_time")
}

// ─── Serotonin detox plan ────────────────────────────────────────────────────

model DetoxPlan {
  id        String   @id @default(cuid())
  userId    String   @unique
  planData  Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("detox_plans")
}

// ─── Serotonin wellness session (pillars/rituals/mood, rotates daily) ────────

model SerotoninSession {
  id          String   @id @default(cuid())
  userId      String   @unique
  sessionData Json
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("serotonin_sessions")
}

// ─── Analytics ───────────────────────────────────────────────────────────────

model AnalyticsSnapshot {
  id                   String          @id @default(cuid())
  userId               String
  period               AnalyticsPeriod
  periodStart          DateTime
  periodEnd            DateTime
  tasksCompleted       Int             @default(0)
  pomodorosCompleted   Int             @default(0)
  pomodorosInterrupted Int             @default(0)
  focusMinutes         Int             @default(0)
  estimatedMinutes     Int             @default(0)
  actualMinutes        Int             @default(0)
  estimationErrorPct   Float?
  serotoninScore       Int?
  fitnessMinutes       Int             @default(0)
  suggestions          Json? // rule-based suggestions generated for the period
  metadata             Json? // extra breakdown (by difficulty, peak hours, etc.)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, periodStart])
  @@index([userId, periodStart])
  @@map("analytics_snapshots")
}

// ─── Habits ──────────────────────────────────────────────────────────────────
// Design ported from mhabit (https://github.com/FriesI23/mhabit, Apache 2.0):
// the domain logic (score curve) is reimplemented natively in
// packages/shared/src/habits/score.ts, not copied — this schema only mirrors
// the concepts (habit type, daily goal, target days) needed to feed it. Score
// is intentionally NOT persisted here: it's recomputed by replaying the full
// HabitRecord history on read, same as mhabit does client-side.

model Habit {
  id                        String    @id @default(cuid())
  userId                    String
  title                     String
  description               String?
  type                      HabitType @default(NORMAL)
  dailyGoalValue            Float     @default(1)
  dailyGoalUnit             String    @default("times")
  dailyGoalExtraValue       Float? // optional bonus/tolerance ceiling, see mhabit's scoreExtraMax
  targetDays                Int       @default(66) // days to consolidate the habit; parametrizes the score curve
  color                     String?
  category                  String?
  archived                  Boolean   @default(false)
  // Case-insensitive match against FitnessEntry.activityType; when set, a matching fitness log
  // auto-creates/updates today's HabitRecord instead of requiring a manual check-in.
  linkedFitnessActivityType String?
  // Task 11.5: optional reminder window driving the mobile confirmation notification (task 11.6).
  // Nullable/no migration-of-existing-data needed -- a habit with no reminder set simply never
  // schedules one, same as every existing web-created Habit row before this field existed.
  // reminderEndMinute is also the notification's fire time for a deadline-style habit (e.g.
  // "wake up before 7am" has no start, just an end); reminderStartMinute matters for a
  // window-style habit (e.g. "arreglarse 7-8am") where the UI wants to show both bounds.
  reminderStartMinute       Int?
  reminderEndMinute         Int?
  reminderDaysOfWeek        Int[]     @default([0, 1, 2, 3, 4, 5, 6]) // 0=Sunday..6=Saturday, matches Schedule.daysOfWeek's convention
  kind                      HabitKind @default(HABIT)
  clientId                  String? // offline sync id from client
  deletedAt                 DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  records        HabitRecord[]
  journalEntries JournalEntry[]

  @@unique([userId, clientId])
  @@index([userId, archived])
  @@map("habits")
}

model HabitRecord {
  id             String            @id @default(cuid())
  habitId        String
  userId         String
  date           DateTime // calendar day this check-in belongs to
  value          Float             @default(0)
  status         HabitRecordStatus @default(DONE)
  autoCompleted  Boolean           @default(false) // true when derived from a FitnessEntry instead of a manual check-in
  fitnessEntryId String?
  clientId       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  habit          Habit          @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fitnessEntry   FitnessEntry?  @relation(fields: [fitnessEntryId], references: [id], onDelete: SetNull)
  journalEntries JournalEntry[]

  @@unique([habitId, date])
  @@unique([userId, clientId])
  @@index([userId, date])
  @@map("habit_records")
}

model JournalEntry {
  id        String   @id @default(cuid())
  habitId   String
  userId    String
  recordId  String?
  content   String
  clientId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  habit  Habit        @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  record HabitRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)

  @@unique([userId, clientId])
  @@index([habitId, createdAt])
  @@map("journal_entries")
}

// ─── Daily email report (daily-email-report, 2026-10-29) ─────────────────────
// Server-only, not synced: the report is an email, and the suggestion is read and answered through
// /planning/suggestions while online (approving it writes the tasks, which do sync).

/**
 * One report sent: the day it covers, so it goes out once per day even across restarts.
 */
model DailyReport {
  id     String   @id @default(cuid())
  userId String
  /**
   * The local day the report covers (YYYY-MM-DD).
   */
  date   String
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_reports")
}

enum PlanSuggestionStatus {
  PENDING
  APPROVED
  DISMISSED
}

/**
 * A plan of blocks the report proposed for a day with nothing planned, waiting for the user.
 */
model PlanSuggestion {
  id        String               @id @default(cuid())
  userId    String
  /**
   * The local day it plans (YYYY-MM-DD).
   */
  date      String
  timeZone  String
  status    PlanSuggestionStatus @default(PENDING)
  /**
   * The planner's PlanProposal (planning.types.ts), with the task titles at the time.
   */
  proposal  Json
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("plan_suggestions")
}

// The Sunday report (weekend-mode, 2026-11-04): one row per week sent, Monday's date as the key. Keeps
// the week's data (the same JSON as the attachment) so the app can show past weeks and the next
// report can compare without recomputing.
model WeeklyReport {
  id        String    @id @default(cuid())
  userId    String
  /**
   * The week's Monday, local (YYYY-MM-DD).
   */
  weekStart String
  data      Json
  /**
   * Null until the scheduled Sunday send (a manual or preview build doesn't count as sent).
   */
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
  @@map("weekly_reports")
}

// "No se puede cerrar" (weekend-mode, 2026-11-04): while it lasts the night block can't be weakened
// from any device (sync refuses it) and the apps resist being closed or uninstalled. Only ever
// extended: endsAt null = indefinitely. Server-only; the clients read it from the sync snapshot.
model BlockCommitment {
  id        String    @id @default(cuid())
  userId    String    @unique
  startedAt DateTime  @default(now())
  endsAt    DateTime?
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("block_commitments")
}

// ─── Projects (projects-and-claude-bridge, 2026-11-08) ──────────────────────────
// The user's projects (research, studies, applications, side projects) and their progress log.
// Synced like Task: clientId for offline creates, deletedAt for soft deletes, updatedAt wins.

enum ProjectStatus {
  ACTIVE
  PAUSED
  BLOCKED
  IDEA
  DONE
}

enum ProjectPriority {
  HIGH
  MEDIUM
  LOW
}

enum ProjectLogSource {
  APP
  CLAUDE
}

model Project {
  id        String          @id @default(cuid())
  userId    String
  title     String
  summary   String?
  status    ProjectStatus   @default(ACTIVE)
  priority  ProjectPriority @default(MEDIUM)
  area      String?
  color     String?
  // A calendar day, stored as that day's UTC midnight (HabitRecord.date's convention).
  deadline  DateTime?
  // 0-100; null = not estimated, shown as "Avance sin estimar", never as 0 %.
  progress  Int?
  nextSteps String[]        @default([])
  blocker   String?
  // 2026-11-09: the general objective, the specific ones ([{ text, done }]) and free tags
  // (sub-classifications inside an area). With no stored progress, progress = specific done / total.
  generalObjective   String?
  specificObjectives Json     @default("[]")
  tags               String[] @default([])
  clientId  String?
  deletedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      Task[]
  logEntries ProjectLogEntry[]

  @@unique([userId, clientId])
  @@index([userId, status])
  @@map("projects")
}

// Kept in its own table, not inside Project: a new entry would otherwise conflict with a concurrent
// project edit. Editable (typos), updatedAt wins.
model ProjectLogEntry {
  id        String           @id @default(cuid())
  userId    String
  projectId String
  date      DateTime
  text      String
  source    ProjectLogSource @default(APP)
  clientId  String?
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([userId, projectId, date])
  @@map("project_log_entries")
}
