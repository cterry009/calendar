<?xml version="1.0" encoding="utf-8"?>
<!-- typeWindowContentChanged + canRetrieveWindowContent + flagReportViewIds (2026-10-06): reading
     the browser's address bar by view id, for time per website and blocking listed sites
     (WebsiteUsage.kt). Only browser packages' content events are looked at. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagReportViewIds"
  android:notificationTimeout="100"
  android:canRetrieveWindowContent="true"
  android:description="@string/focus_block_accessibility_service_description" />
